# Camera connection (DVRIP). CAM_PASS is required; the login user is "admin"
# on factory firmware, and the web/RTSP user may be a different account.
CAM_HOST=192.168.1.10
CAM_PORT=34567
CAM_USER=admin
CAM_PASS=changeme

# Names: CAM_NAME becomes the MQTT topic and entity_id prefix (latin, no spaces),
# DEVICE_NAME is what you see in Home Assistant.
CAM_NAME=xiongmai
DEVICE_NAME=Xiongmai camera
DEVICE_MODEL=Xiongmai IPG-G4-WR-BL (GK7202V300)

# Preset slots exposed as buttons: JSON map slot -> label.
# Do not use 100, 128, 141, 250 (firmware-internal) or 255 (outside the table).
PRESETS={"1": "Bed", "2": "Door"}

# PTZ behaviour. The head moves continuously while a direction is held, so a
# button press is a bounded impulse followed by an explicit stop.
PTZ_IMPULSE=0.8
# Direction used for the final approach; keeps backlash out of the result.
# Empty string disables the compensation (single GotoPreset, less accurate).
PTZ_APPROACH=DirectionRightDown
PRESET_SETTLE=9
PRESET_NUDGE=0.4

# MQTT broker
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# How often the switches and numbers are refreshed, seconds
POLL_SECONDS=30
